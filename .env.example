# ==========================================================================
# mcpgate — Environment Configuration
# ==========================================================================
#
# You do NOT need this file to start. `docker compose up -d` works without
# a .env: the gateway generates JWT_SECRET and ENCRYPTION_KEY on first start
# and persists them in the gateway-data volume (/app/data/gateway.env), and
# the setup wizard at http://localhost:8642 covers login, team and services.
#
# Use this file when you prefer configuration as code. Copy it to .env and
# fill in your values. Values in .env take priority over wizard settings.
#
# HOW THIS WORKS:
# - Uncomment a line and set a value to enable a feature/service
# - Services only activate when their credentials are provided
# - The gateway works with as few as 1 service connected
#
# WHAT AN ENV-ONLY SETUP NEEDS AT MINIMUM:
# 1. BASE_URL              — where the gateway runs
# 2. CORS_ALLOWED_ORIGINS  — defaults to BASE_URL when unset
# 3. ADMIN_USERS           — who can access the admin dashboard
# 4. COMPANY_DOMAINS       — which email domains can sign in
# 5. REDIS_PASSWORD        — pick any strong password
# 6. At least one service (e.g. Google Workspace or Slack)
# JWT_SECRET and ENCRYPTION_KEY are optional: if unset, the gateway
# generates them on first start (see SECURITY below).
#
# ==========================================================================


# ╔════════════════════════════════════════════════════════════════════════╗
# ║  CORE — Required                                                      ║
# ╚════════════════════════════════════════════════════════════════════════╝

# Public URL where the gateway is accessible.
# Used for OAuth callback URLs and MCP endpoint.
# Example: https://mcpgate.yourcompany.com
BASE_URL=

# CORS allowed origins. Defaults to BASE_URL when unset.
# Comma-separated for multiple origins.
# Example: https://mcpgate.yourcompany.com,https://chatgpt.com
CORS_ALLOWED_ORIGINS=

# Who can access the /admin dashboard and /connections page.
# Comma-separated email addresses.
ADMIN_USERS=

# Which email domains are allowed to sign in via SSO (OIDC).
# Comma-separated, with @ prefix.
# Example: @yourcompany.com,@subsidiary.com
COMPANY_DOMAINS=

# Your timezone. Used for date formatting in responses and scheduled jobs.
# Format: IANA timezone (see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
# Examples: Europe/Berlin, America/New_York, Asia/Tokyo, UTC
DEFAULT_TIMEZONE=Europe/Berlin


# ╔════════════════════════════════════════════════════════════════════════╗
# ║  SECURITY — Optional (auto-generated on first start if unset)         ║
# ╚════════════════════════════════════════════════════════════════════════╝

# If you leave these empty, the gateway generates them on first start and
# persists them in /app/data/gateway.env (the gateway-data volume). Keep that
# volume: a new ENCRYPTION_KEY cannot decrypt tokens stored with the old one.

# Token signing key (at least 32 characters).
# Generate: openssl rand -hex 32
JWT_SECRET=

# AES-256 key for stored OAuth tokens and sessions (base64-encoded 32 bytes).
# Generate: python3 -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=

# Cookie and state signing secret for OIDC login (at least 32 characters).
# Falls back to ENCRYPTION_KEY when unset.
# Generate: openssl rand -hex 32
# SESSION_SECRET=

# For stronger security: use your own GCP KMS key instead of ENCRYPTION_KEY.
# You control the key — revoke it and all tokens become unreadable.
# GCP_KMS_KEY_NAME=projects/YOUR_PROJECT/locations/YOUR_REGION/keyRings/YOUR_RING/cryptoKeys/YOUR_KEY
# GCP_KMS_CREDENTIALS=<base64-encoded service account JSON>


# ╔════════════════════════════════════════════════════════════════════════╗
# ║  REDIS — Required                                                     ║
# ╚════════════════════════════════════════════════════════════════════════╝

# If using the included docker-compose.yaml, keep the URL as-is.
# Only change REDIS_PASSWORD.
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# Optional second Redis that holds only authentication state (OAuth tokens,
# sessions). Unset = one Redis for everything. If you set it, you can give
# the main Redis an eviction policy while this one keeps noeviction.
# AUTH_REDIS_URL=redis://redis-auth:6379/0
# Password for AUTH_REDIS_URL. Defaults to REDIS_PASSWORD.
# AUTH_REDIS_PASSWORD=


# ╔════════════════════════════════════════════════════════════════════════╗
# ║  LICENSE — Optional                                                    ║
# ╚════════════════════════════════════════════════════════════════════════╝

# Commercial license key. Not needed for production use with up to 5 users
# (see LICENSE and COMMERCIAL.md). You can also enter it in the admin UI.
# SUBSCRIPTION_KEY=


# ╔════════════════════════════════════════════════════════════════════════╗
# ║  SERVICES — Enable by uncommenting and filling in credentials          ║
# ║                                                                        ║
# ║  Each service is independent. Enable only what you need.               ║
# ║  The gateway auto-detects which services are configured.               ║
# ╚════════════════════════════════════════════════════════════════════════╝


# Provider setup notes for AI-guided onboarding live in
# config/setup_catalog.yaml.
#
# This file lists only some services. All other built-in services (e.g.
# Confluence, GitHub, Microsoft 365, HubSpot, Pipedrive, BigQuery, Google
# Ads, Power BI, AWS, Apple Ads, AppFollow) are set up in the setup wizard.
# Each service card in the wizard names the variables it needs.
#

# ── SSO Authentication (OIDC) ───────────────────────────────────────────
#
# Single Sign-On for user login. Works with any OIDC-compliant provider.
# This is ONLY for logging into mcpgate — not for service connections.
# Without OIDC, users sign in through the broker login (Google/Microsoft).
#
# OIDC_PROVIDER      — google, microsoft or custom
# OIDC_TENANT_ID     — Entra tenant ID (required for microsoft)
# OIDC_ISSUER_URL    — issuer URL (required for custom, e.g. Okta, Keycloak)
# OIDC_CLIENT_ID     — OAuth client ID from your IdP
# OIDC_CLIENT_SECRET — OAuth client secret from your IdP
#
# Setup:
# 1. Create an OAuth/OIDC application in your identity provider
# 2. Set redirect URI to: <BASE_URL>/auth/callback
# 3. Copy client ID and secret below
#
# OIDC_PROVIDER=
# OIDC_TENANT_ID=
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
#
# First admin: the email, UPN or OIDC subject of the person who becomes
# admin at first login, before ADMIN_USERS is set.
# BOOTSTRAP_ADMIN_PRINCIPAL_ID=
#
# Set to true to switch the bootstrap admin off after the team is set up.
# DISABLE_BOOTSTRAP_ADMIN=false


# ── Google Workspace (Gmail, Calendar, Drive, Docs, Sheets, Slides) ──────
#
# NOTE: This is for Google Workspace service connections, NOT for SSO login.
#       SSO is configured above via OIDC. These credentials let mcpgate
#       access Google APIs (Calendar, Gmail, Drive, etc.) on behalf of users.
#
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web Application)
# 3. Add authorized redirect URI: <BASE_URL>/auth/google/callback
# 4. Enable the APIs you need (Gmail, Calendar, Drive, Docs, Sheets)
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=


# ── Slack ────────────────────────────────────────────────────────────────
#
# 1. Create a Slack App at https://api.slack.com/apps
# 2. Add bot token scopes: channels:history, channels:read, chat:write,
#    search:read, users:read, users:read.email
# 3. Install to your workspace
#
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_TEAM_ID=


# ── Jira ─────────────────────────────────────────────────────────────────
#
# 1. Go to https://developer.atlassian.com/console/myapps/
# 2. Create OAuth 2.0 (3LO) app
# 3. Authorization → click "Configure" → set callback URL: <BASE_URL>/auth/jira/callback
# 4. Permissions → add "Jira API" AND "User Identity API" (two separate APIs!)
# 5. For each API: click "Edit Scopes" (top right) — checkboxes are read-only otherwise
#    - Jira API (Classic): read:jira-user, read:jira-work, write:jira-work
#    - User Identity API: read:me
# 6. offline_access is sent automatically by mcpgate — nothing to toggle in the console
#
# JIRA_OAUTH_CLIENT_ID=
# JIRA_OAUTH_CLIENT_SECRET=
# JIRA_BASE_URL=https://yourcompany.atlassian.net


# ── GitLab ───────────────────────────────────────────────────────────────
#
# 1. In GitLab: Admin → Applications (or User Settings → Applications)
# 2. Create OAuth application
# 3. Redirect URI: <BASE_URL>/auth/gitlab/callback
# 4. Scopes: api, read_user
#
# GITLAB_OAUTH_CLIENT_ID=
# GITLAB_OAUTH_CLIENT_SECRET=
# GITLAB_BASE_URL=https://gitlab.com


# ── Notion ───────────────────────────────────────────────────────────────
#
# 1. Go to https://www.notion.so/my-integrations
# 2. Create internal integration
# 3. Share relevant pages/databases with the integration
#
# NOTION_OAUTH_CLIENT_ID=
# NOTION_OAUTH_CLIENT_SECRET=


# ── Figma ────────────────────────────────────────────────────────────────
#
# 1. Figma account settings → create OAuth app
# 2. Redirect URI: <BASE_URL>/auth/figma/callback
#
# FIGMA_OAUTH_CLIENT_ID=
# FIGMA_OAUTH_CLIENT_SECRET=


# ── Grafana (Dashboards, Logs, Metrics) ──────────────────────────────────
#
# 1. Create a Service Account in Grafana
# 2. Generate API key with viewer role (or editor if you want write access)
#
# GRAFANA_URL=https://grafana.yourcompany.com
# GRAFANA_API_KEY=


# ── Amplitude (Product Analytics) ────────────────────────────────────────
#
# Connects through Amplitude's hosted MCP server. No variables needed:
# each user connects on the /connections page.


# ── Sentry (Error Tracking) ─────────────────────────────────────────────
#
# User settings → Auth Tokens → create token
#
# SENTRY_AUTH_TOKEN=
# SENTRY_BASE_URL=https://sentry.io/api/0
# SENTRY_ORG=


# ── Metabase (BI / Data Warehouse) ──────────────────────────────────────
#
# Uses Google OAuth for user authentication.
# Create a separate OAuth client for Metabase in Google Cloud Console.
#
# METABASE_URL=https://metabase.yourcompany.com
# METABASE_GOOGLE_CLIENT_ID=
# METABASE_GOOGLE_CLIENT_SECRET=


# ── Jenkins (CI/CD) ─────────────────────────────────────────────────────
#
# JENKINS_URL=https://jenkins.yourcompany.com


# ── Home Assistant (Office Sensors & Heating) ────────────────────────────
#
# User profile → Long-Lived Access Token
#
# HOME_ASSISTANT_URL=
# HOME_ASSISTANT_ACCESS_TOKEN=


# ── Joan (Desk & Meeting Room Booking) ───────────────────────────────────
#
# JOAN_API_KEY=
# JOAN_API_SECRET=
# JOAN_API_URL=


# ── WordPress (Posts, Pages, Yoast SEO) ────────────────────────────────
#
# Multi-instance: add one pair per site. Name is free-form.
# WP_<NAME>_URL = WordPress REST API endpoint (must end with /wp-json/)
# WP_<NAME>_AUTH = Base64 encoded "username:application_password"
#
# Generate auth: echo -n "username:xxxx xxxx xxxx xxxx xxxx xxxx" | base64
# Application passwords: WordPress → Users → Profile → Application Passwords
#
# For Yoast SEO write access, a PHP snippet is required.
# See docs/setup/wordpress-yoast-setup.md
#
# WP_BLOG_URL=https://yoursite.com/wp-json/
# WP_BLOG_AUTH=

# WP_HELP_URL=https://yoursite.com/help/wp-json/
# WP_HELP_AUTH=


# ── App Store Connect & Google Play (Mobile Release Monitoring) ──────────
#
# ASC_KEY_ID=
# ASC_ISSUER_ID=
# ASC_KEY_CONTENT=
# GOOGLE_PLAY_CREDENTIALS=


# ╔════════════════════════════════════════════════════════════════════════╗
# ║  AI MODELS — Optional, requires an AI provider API key                ║
# ║                                                                        ║
# ║  Keys for the AI Models connector (language-model completions for      ║
# ║  automations). The core gateway (tool access + hooks) works WITHOUT    ║
# ║  these. Pick models and endpoints in the setup wizard.                 ║
# ╚════════════════════════════════════════════════════════════════════════╝

# Anthropic API key (claude-* models)
# AI_ANTHROPIC_KEY=

# OpenAI API key (gpt-* models), or the key of another OpenAI-compatible endpoint
# AI_API_KEY=

# ChatGPT Custom GPT integration (if using ChatGPT Actions)
# CHATGPT_CLIENT_ID=
# CHATGPT_CLIENT_SECRET=


# ╔════════════════════════════════════════════════════════════════════════╗
# ║  BUG & FEATURE REPORTS — Optional                                      ║
# ║                                                                        ║
# ║  When enabled, users can send bug reports and feature requests from    ║
# ║  their AI client to mcpgate. We fix them and ship an updated image.    ║
# ╚════════════════════════════════════════════════════════════════════════╝

# Instance token for reports to mcpgate (provided during onboarding).
# MCPGATE_FEEDBACK_INSTANCE_TOKEN=
# Report endpoint. Default: https://api.mcpgate.de/feedback
# MCPGATE_FEEDBACK_URL=


# ╔════════════════════════════════════════════════════════════════════════╗
# ║  ADVANCED — Usually fine with defaults                                 ║
# ╚════════════════════════════════════════════════════════════════════════╝

# The container listens on port 3001. Change the published host port
# (8642) in docker-compose.yaml if it conflicts with another service.

# Environment name (affects logging, debug mode, CORS)
# ENVIRONMENT=production

# Log level: debug, info, warning, error
# LOG_LEVEL=info

# Sender address for automated email notifications
# SYSTEM_EMAIL=noreply@yourcompany.com
